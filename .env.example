JCR_LISTEN_ADDRESS=127.0.0.1:5000
JCR_PUBLIC_URL=http://127.0.0.1:5000
JCR_DATABASE_URL=postgres://jcr:jcr@127.0.0.1:5432/jcr
JCR_JWT_SECRET=replace-with-at-least-32-random-bytes
JCR_REGISTRATION_MODE=allowlist

# The only identity allowed to create an account in the default mode.
JCR_BOOTSTRAP_EMAIL=jose@example.com
JCR_BOOTSTRAP_USERNAME=jose
JCR_BOOTSTRAP_NAMESPACE=jose

# Google OAuth is optional for local protocol development.
JCR_GOOGLE_CLIENT_ID=
JCR_GOOGLE_CLIENT_SECRET=
JCR_GOOGLE_REDIRECT_URL=http://127.0.0.1:5000/registry/auth/callback

# Use "filesystem" for the zero-dependency local default or "bucket" for any
# supported S3-compatible service, including Garage and R2.
JCR_STORAGE_BACKEND=filesystem
JCR_FILESYSTEM_ROOT=.data/storage
JCR_BUCKET_ENDPOINT=http://127.0.0.1:9000
JCR_BUCKET_REGION=garage
JCR_BUCKET_NAME=jcr
JCR_BUCKET_ACCESS_KEY_ID=GK0123456789abcdef0123456789abcdef
JCR_BUCKET_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JCR_BUCKET_FORCE_PATH_STYLE=true

JCR_UPLOAD_CHUNK_LIMIT_MIB=80
JCR_UPLOAD_SESSION_HOURS=24
JCR_GC_GRACE_DAYS=7
